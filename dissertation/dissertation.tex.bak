\label{tab:curriculum}
\small
\begin{tabular}{@{}lcc@{}}
\toprule
\textbf{Schedule} & \textbf{Rest14 (ID)} & \textbf{Laptop14 (OOD)} \\
\midrule
NL baseline & 0.722 & 0.525 \\
\midrule
Overlap-first & 0.716 & 0.509 \\
Overlap-first + dep. & 0.718 & 0.514 \\
Fast ramp & 0.725 & 0.503 \\
Fast ramp + dep. & 0.706 & 0.523 \\
Sandwich & 0.728 & 0.517 \\
Sandwich + dep. & 0.715 & 0.501 \\
\bottomrule
