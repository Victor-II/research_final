\label{tab:crossmethod}
\small
\begin{tabular}{@{}lccc@{}}
\toprule
\textbf{Method} & \textbf{Params} & \textbf{Rest14 (ID)} & \textbf{Laptop14 (OOD)} \\
\midrule
\multicolumn{4}{l}{\textit{LLMs (few-shot, no fine-tuning)}} \\
\midrule
Gemma2 27B 0-shot & 27B & 0.44 & 0.28 \\
Gemma2 27B 6-shot & 27B & 0.65 & 0.41 \\
Qwen2.5 32B 0-shot & 32B & 0.54 & 0.36 \\
Qwen2.5 32B 6-shot & 32B & 0.60 & 0.37 \\
Command-R 6-shot & 35B & 0.58 & 0.37 \\
\midrule
\multicolumn{4}{l}{\textit{Discriminative (fine-tuned)}} \\
\midrule
RoBERTa span (ours) & 125M & 0.54 & 0.38 \\
XLM-R span (ours) & 278M & 0.47 & 0.34 \\
\midrule
\multicolumn{4}{l}{\textit{Generative (fine-tuned)}} \\
\midrule
T5 structured baseline & 250M & 0.693 & 0.439 \\
T5 NL baseline & 250M & 0.722 & 0.525 \\
T5 NL + multi-ordering & 250M & 0.730 & 0.524 \\
\midrule
\multicolumn{4}{l}{\textit{Published (in-domain only)}} \\
\midrule
Span-ASTE & $\sim$110M & 0.73 & --- \\
